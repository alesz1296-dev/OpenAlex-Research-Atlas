# Environment configuration template for OpenAlex Research Atlas
# Copy this to .env.local and fill in your local values
# .env.local is excluded from git (see .gitignore)

# Database Configuration
# For local development, use PostgreSQL or SQLite
# PostgreSQL example:
DATABASE_URL=postgresql://openalex_user:openalex_password@localhost:5432/openalex_research
TEST_DATABASE_URL=postgresql://openalex_user:openalex_password@localhost:5432/openalex_research
# SQLite example (simpler for learning):
# DATABASE_URL=sqlite:///./openalex_research.db

# Database echo - set to true to see SQL queries
DATABASE_ECHO=false

# Environment
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_TITLE=OpenAlex Research Atlas
API_VERSION=0.1.0

# OpenAlex API (for ingestion, added in Phase 1)
OPENALEX_BASE_URL=https://api.openalex.org
# Adding your email improves OpenAlex etiquette and can help with support.
OPENALEX_MAILTO=
OPENALEX_USER_AGENT=OpenAlexResearchAtlas/0.1.0
OPENALEX_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
